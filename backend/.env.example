# Copie para backend/.env e ajuste se precisar.
# Banco do Docker Compose, acessado pelo driver psycopg (versão 3).
DATABASE_URL=postgresql+psycopg://estoque:estoque@localhost:5432/estoque

# Origens do frontend autorizadas pelo CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
